# Redirect all requests to public folder
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Deny direct access to secrets if docroot is ever mis-set to app root
<FilesMatch "(?i)^\.(env|error)">
    Require all denied
</FilesMatch>
